<+>/* Font import */\n@import url('https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900&display=swap');\n\n* {\n    margin: 0;\n    box-sizing: border-box;\n}\n\nbody {\n    font-family: Poppins, sans-serif;\n    background-color: #f4f4f4;\n    height: 100vh;\n    margin: 0;\n}\n\n/* Main content area */\n.main-content {\n    margin-left: 290px;\n    width: calc(100% - 250px);\n    background-color: #f5f5f5;\n    overflow-y: auto;\n}\n\n/* Header styles */\n.header {\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-start;\n    margin-bottom: 10px;\n}\n\n.scan-info {\n    display: flex;\n    flex-direction: column;\n}\n\n.vulnerability {\n    margin-top: auto;\n    align-self: flex-end;\n}\n\n\n.header h1 {\n    font-size: 22px;\n    color: #4f4f4f;\n}\n\n.header .ip-address {\n    color: #8a2be2;\n}\n\n.header .vulnerability {\n    color: #ff4d4d;\n}\n\n/* Alerts section */\n.alerts-section {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    background-color: #e0e7ff;\n    padding: 20px;\n    border-radius: 5px;\n    margin-bottom: 30px;\n}\n\n\n.alert-levels {\n    flex-grow: 1;\n    padding-left: 30px;\n}\n\n.alert {\n    font-size: 18px;\n    font-weight: bold;\n    margin-bottom: 10px;\n}\n\n#progressChart {\n    width: 100% !important;\n    height: 170px !important;\n}\n\n.alert.high {\n    color: #ff3333;\n}\n\n.alert.medium {\n    color: #ff9900;\n}\n\n.alert.low {\n    color: #99cc33;\n}\n\n/* Dashboard layout */\n.dashboard-container {\n    display: flex;\n    width: 100%;\n    height: 100vh;\n}\n\n/* More main content */\n.main-content {\n    flex: 1;\n    padding: 20px;\n    background-color: #f5f5f5;\n    overflow-y: auto;\n}\n\n/* Formal table styles */\n.port-table {\n    width: 100%;\n    border-collapse: collapse;\n    background-color: white;\n    border: 1px solid #ddd;\n    border-radius: 10px;\n    font-size: 0.95rem;\n    color: #495057;\n}\n\n.port-table th {\n    background-color: #f8f9fa;\n    /* Softer background color for a more formal look */\n    color: #343a40;\n    font-weight: bold;\n    font-size: 1rem;\n    border-bottom: 2px solid #dee2e6;\n    padding: 15px;\n}\n\n.port-table td {\n    padding: 15px;\n    text-align: left;\n    border: 1px solid #ddd;\n}\n\n/* Table row hover effect */\n.port-table tbody tr:nth-child(even) {\n    background-color: #f2f2f2;\n}\n\n.port-table tbody tr:hover {\n    background-color: #e9ecef;\n}\n\n/* Open/Closed states for table */\n.port-table td.state.open {\n    color: #28a745;\n    /* Green for open */\n}\n\n.port-table td.state.closed {\n    color: #dc3545;\n    /* Red for closed */\n}\n\n.dataTables_wrapper .dataTables_filter {\n    text-align: right; /* Aligns the entire search container to the right */\n}\n\n.dataTables_wrapper .dataTables_filter input {\n    text-align: left; /* Ensures text inside the input box remains left-aligned */\n}\n\n\n/* DataTables customizations */\n.dataTables_wrapper .dataTables_filter input {\n    border: 1px solid #ced4da;\n    border-radius: 5px;\n    padding: 5px 10px;\n    width: 300px;\n    margin-left: 0.5rem;\n}\n\n.dataTables_wrapper .dataTables_length select {\n    border: 1px solid #ced4da;\n    border-radius: 5px;\n    padding: 5px 10px;\n}\n\n.dataTables_wrapper .dataTables_paginate .paginate_button {\n    color: #495057 !important;\n    margin-left: 10px;\n}\n\n.port-table tbody tr {\n    cursor: pointer; /* Changes cursor to indicate row is clickable */\n}\n\n\n
