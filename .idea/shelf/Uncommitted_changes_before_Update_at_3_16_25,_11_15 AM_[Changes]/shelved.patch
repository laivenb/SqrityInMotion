<+><!DOCTYPE html>\n<html lang=\"en\">\n\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>SQrity | User Requests</title>\n    <link href=\"https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css\" rel=\"stylesheet\">\n    <link href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css\" rel=\"stylesheet\">\n    <link rel=\"stylesheet\" href=\"css/sidebar.css\">\n    <link rel=\"stylesheet\" href=\"css/user-req.css\">\n</head>\n\n<body>\n<div class=\"container-fluid\">\n    <div class=\"row\">\n        <!-- Sidebar -->\n        <div id=\"sidebar-container\">\n            <!-- Sidebar content will be injected here dynamically -->\n        </div>\n\n        <!-- Main Content -->\n        <div class=\"main-content\">\n            <div class=\"user-requests\">\n                <h2>User Requests</h2>\n                <table id=\"userRequestsTable\" class=\"table table-striped table-bordered\">\n                    <thead>\n                    <tr>\n                        <th>Last Name</th>\n                        <th>First Name</th>\n                        <th>Middle Name</th>\n                        <th>Email</th>\n                        <th>Department</th>\n                        <th>Position</th>\n                        <th>Request Date</th>\n                        <th>Action</th>\n                    </tr>\n                    </thead>\n                    <tbody>\n                    <tr>\n                        <td>Doe</td>\n                        <td>John</td>\n                        <td>A.</td>\n                        <td>johndoe@example.com</td>\n                        <td>Engineering</td>\n                        <td>Software Developer</td>\n                        <td>2023-03-15</td>\n                        <td>\n                            <div class=\"action-buttons\">\n                                <button class=\"btn allow-btn btn-sm\">Allow</button>\n                                <button class=\"btn deny-btn btn-sm\">Deny</button>\n                            </div>\n                        </td>\n                    </tr>\n                    <tr>\n                        <td>Smith</td>\n                        <td>Jane</td>\n                        <td>B.</td>\n                        <td>janesmith@example.com</td>\n                        <td>Human Resources</td>\n                        <td>HR Manager</td>\n                        <td>2023-02-28</td>\n                        <td>\n                            <div class=\"action-buttons\">\n                                <button class=\"btn allow-btn btn-sm\">Allow</button>\n                                <button class=\"btn deny-btn btn-sm\">Deny</button>\n                            </div>\n                        </td>\n                    </tr>\n                    </tbody>\n\n                </table>\n            </div>\n        </div>\n    </div>\n</div>\n\n<!-- Action Confirmation Modal -->\n<div class=\"modal fade\" id=\"actionConfirmationModal\" tabindex=\"-1\" aria-labelledby=\"actionConfirmationModalLabel\" aria-hidden=\"true\">\n    <div class=\"modal-dialog modal-dialog-centered\">\n        <div class=\"modal-content\">\n            <div class=\"modal-header\">\n                <h5 class=\"modal-title\" id=\"actionConfirmationModalLabel\">Action Confirmation</h5>\n                <button type=\"button\" class=\"close\" data-dismiss=\"modal\" aria-label=\"Close\">\n                    <span aria-hidden=\"true\">&times;</span>\n                </button>\n            </div>\n            <div class=\"modal-body\" id=\"confirmationMessage\">\n                <!-- Success message will be populated here dynamically -->\n            </div>\n            <div class=\"modal-footer\">\n                <button type=\"button\" class=\"btn btn-secondary\" data-dismiss=\"modal\">Close</button>\n            </div>\n        </div>\n    </div>\n</div>\n\n\n<!-- Scripts -->\n<script src=\"https://code.jquery.com/jquery-3.5.1.min.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.6/dist/umd/popper.min.js\"></script>\n<script src=\"https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js\"></script>\n<script src=\"https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js\"></script>\n<script src=\"https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap4.min.js\"></script>\n<script type=\"module\" src=\"js/user-req.js\"></script>\n<script src=\"js/adminSidebar.js\"></script>\n\n<script>\n    $(document).ready(function () {\n        // Initialize DataTable\n        $('#userRequestsTable').DataTable({\n            \"pageLength\": 10,\n            \"lengthMenu\": [5, 10, 25, 50],\n            \"ordering\": true,\n            \"searching\": true,\n            \"responsive\": true,\n        });\n\n        // Variable to store the action message\n        let actionMessage = '';\n\n        // Handle Allow button click\n        $('#userRequestsTable tbody').on('click', '.allow-btn', function () {\n            const row = $(this).closest('tr');\n            row.remove(); // Delete row immediately\n            $('#confirmationMessage').text('User request has been successfully accepted.');\n            $('#actionConfirmationModal').modal('show');\n        });\n\n        // Handle Deny button click\n        $('#userRequestsTable tbody').on('click', '.deny-btn', function () {\n            const row = $(this).closest('tr');\n            row.remove(); // Delete row immediately\n            $('#confirmationMessage').text('User request has been successfully denied.');\n            $('#actionConfirmationModal').modal('show');\n        });\n    });\n\n</script>\n</body>\n\n</html>\n
