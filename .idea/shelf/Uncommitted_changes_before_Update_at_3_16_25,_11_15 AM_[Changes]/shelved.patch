<+>const BASE_URL = 'http://192.168.1.48:5000';\nlet ipAddress;\n\nfunction getIPFromURL() {\n    const urlParams = new URLSearchParams(window.location.search);\n    const ip = urlParams.get('ip');\n    console.log(\"Retrieved IP Address:\", ip);\n    return ip;\n}\n\nwindow.addEventListener('load', () => {\n    ipAddress = getIPFromURL();\n\n    const portDetailsArray = JSON.parse(sessionStorage.getItem('portDetailsArray')) || [];\n    console.log(\"Retrieved Port Details Array:\", portDetailsArray);\n\n    // Add event listener to the attack button\n    document.getElementById('attackButton').addEventListener('click', () => {\n        // Check if there are port details before attempting the exploit\n        if (portDetailsArray.length > 0) {\n            exploitRMI(portDetailsArray);\n        } else {\n            console.log(\"No port details available for exploitation.\");\n        }\n    });\n});\n\n// Function to exploit Java RMI\nfunction exploitRMI(portDetailsArray) {\n    fetch(`${BASE_URL}/exploit_rmi`, {\n        method: 'POST',\n        headers: {\n            'Content-Type': 'application/json'\n        },\n        body: JSON.stringify({\n            ipAddress: ipAddress,\n            ports: portDetailsArray // Pass the port details if needed\n        })\n    })\n        .then(response => response.json())\n        .then(data => {\n            if (data.error) {\n                console.error(\"Error:\", data.error);\n            } else {\n                console.log(\"Exploit Output:\", data.output);\n                // Optionally, you can add further processing of the output here\n            }\n        })\n        .catch(error => {\n            console.error(\"Fetch error:\", error);\n        });\n}\n\n// Initialize and set up xterm.js terminal\nconst terminal = new Terminal();\nterminal.open(document.getElementById('terminal'));\n\n// Connect to the Flask server via WebSocket\nconst socket = io.connect(`${location.protocol}//${document.domain}:${location.port}/terminal`);\n\n// Handle incoming output from the server\nsocket.on('output', (data) => {\n    terminal.write(data.output);\n});\n\n// Send input to the server when the user types\nterminal.onData((input) => {\n    socket.emit('input', { 'command': input });\n});\n\n// Initial welcome message in the terminal\nterminal.write(\"Welcome to the Metasploit Terminal!\\r\\n\");
